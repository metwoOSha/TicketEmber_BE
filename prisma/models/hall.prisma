enum HallType {
    SMALL
    STANDARD
    THREE_D
}

enum SeatType {
    STANDARD
    SOFA
}

model Hall {
    id      Int      @id @default(autoincrement())
    name    String   @unique
    type    HallType
    columns Int
    seats   Seat[]
}

model Seat {
    id     Int      @id @default(autoincrement())
    hallId Int
    hall   Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
    row    Int
    number Int
    type   SeatType @default(STANDARD)

    @@unique([hallId, row, number])
}
