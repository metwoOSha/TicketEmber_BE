enum HallType {
    SMALL
    STANDARD
    THREE_D

    @@map("hall_type")
}

enum SeatType {
    STANDARD
    SOFA

    @@map("seat_type")
}

model Hall {
    id      Int      @id @default(autoincrement())
    name    String   @unique
    type    HallType
    columns Int
    seats   Seat[]

    @@map("halls")
}

model Seat {
    id     Int      @id @default(autoincrement())
    hallId Int      @map("hall_id")
    hall   Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
    row    Int
    number Int
    type   SeatType @default(STANDARD)

    @@unique([hallId, row, number])
    @@map("seats")
}
